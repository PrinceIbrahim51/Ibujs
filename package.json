{
  "name": "ibujs-workspace",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "ibu dev",
    "build": "ibu build",
    "start": "ibu start",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:e2e": "node tests/e2e/security.e2e.mjs && node tests/e2e/url-differential.e2e.mjs",
    "typecheck": "tsc --noEmit",
    "security": "ibu check",
    "demo": "node scripts/build-demo.mjs",
    "check": "npm run typecheck && npm test && npm run security && npm run build",
    "bench": "node scripts/bench-render.mjs",
    "release": "node scripts/release.mjs --verify",
    "build:vercel": "npm run demo && ibu build --target=vercel"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
